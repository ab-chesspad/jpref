/build/*
# except the release apk and bundle: a file under an ignored directory cannot be re-included,
# so every directory on its path is opened and its other contents ignored
!/build/outputs/
/build/outputs/*
!/build/outputs/apk/
/build/outputs/apk/*
!/build/outputs/apk/release/
/build/outputs/apk/release/*
!/build/outputs/apk/release/app-release.apk
!/build/outputs/bundle/
/build/outputs/bundle/*
!/build/outputs/bundle/release/
/build/outputs/bundle/release/*
!/build/outputs/bundle/release/app-release.aab
