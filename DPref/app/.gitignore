/build/*
# except the debug apk: a file under an ignored directory cannot be re-included,
# so every directory on its path is opened and its other contents ignored
!/build/outputs/
/build/outputs/*
!/build/outputs/apk/
/build/outputs/apk/*
!/build/outputs/apk/debug/
/build/outputs/apk/debug/*
!/build/outputs/apk/debug/app-debug.apk
